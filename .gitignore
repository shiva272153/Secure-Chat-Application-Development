# ═══════════════════════════════════════════════
# SecureChat — .gitignore
# ═══════════════════════════════════════════════

# ── Environment & Secrets ──
.env
*.pem
*.key

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ──
venv/
.venv/
env/
ENV/

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ── OS artifacts ──
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Database files ──
*.db
*.sqlite3

# ── Node (if added later) ──
node_modules/
package-lock.json

# ── Logs & temp ──
*.log
*.tmp
*.bak

# ── Flask session files ──
flask_session/
