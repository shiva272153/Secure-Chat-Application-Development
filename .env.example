# ═══════════════════════════════════════════════════════════════════════
# SecureChat — Environment Variables Configuration Template
# Copy this file to .env and replace placeholders with your actual secrets.
# DO NOT commit your real .env file to version control.
# ═══════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# ──────────────────────────────────────────────────────────────────────
# Get your free connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/securechat?retryWrites=true&w=majority
# Note: If your password contains special characters like @ or #, URL-encode them (e.g., @ becomes %40).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/securechat?retryWrites=true&w=majority

# ──────────────────────────────────────────────────────────────────────
# 2. APPLICATION SECURITY
# ──────────────────────────────────────────────────────────────────────
# Secret key used by Flask for cryptographic signing of sessions.
# Generate a strong 64-char hex key by running:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-change-this

# ──────────────────────────────────────────────────────────────────────
# 3. EMAIL OTP AUTHENTICATION (Gmail SMTP)
# ──────────────────────────────────────────────────────────────────────
# Used to send 6-digit verification codes to new users during registration.
#
# SETUP INSTRUCTIONS FOR GMAIL:
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate a 16-character App Password (search "App passwords"):
#    https://myaccount.google.com/apppasswords
# 3. Paste the generated 16-character code (without spaces) below.
#
# DEVELOPER FALLBACK:
# If MAIL_USERNAME or MAIL_PASSWORD are left blank, SecureChat runs in
# Developer Mode: OTP codes will be printed directly to your server console
# and saved to MongoDB so you can test registration without email credentials.

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER="SecureChat <your-email@gmail.com>"

# ──────────────────────────────────────────────────────────────────────
# 4. OTP SECURITY & RATE LIMITING (Optional)
# ──────────────────────────────────────────────────────────────────────
# Validity duration for OTP verification codes in minutes (default: 10)
OTP_EXPIRY_MINUTES=10

# Cooldown time before a user can request another OTP code in seconds (default: 60)
OTP_RESEND_COOLDOWN_SECONDS=60

# ──────────────────────────────────────────────────────────────────────
# 5. GROUP CHAT CONFIGURATION (Optional)
# ──────────────────────────────────────────────────────────────────────
# Maximum number of members allowed in a single group (default: 60)
GROUP_MAX_MEMBERS=60

